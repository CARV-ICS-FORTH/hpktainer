# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.ssh.insert_key = false

  # ==========================================
  # Controller Node
  # ==========================================
  config.vm.define "controller" do |controller|
    controller.vm.hostname = "controller"
    controller.vm.network "forwarded_port", guest: 22, host: 2250, id: "ssh", auto_correct: true

    controller.vm.provider "utm" do |utm|
      utm.name = "skiff-controller"
      utm.cpus = 2
      utm.memory = 2048
      utm.directory_share_mode = "virtFS"
    end

    controller.vm.provider :libvirt do |libvirt|
      libvirt.driver = "kvm"
      libvirt.cpus = 2
      libvirt.memory = 2048
    end

    controller.vm.provision "shell", inline: "echo 'controller' > /etc/vagrant_role"
    controller.vm.provision "shell", path: "install.sh"
  end

  # ==========================================
  # Worker Node
  # ==========================================
  config.vm.define "node" do |node|
    node.vm.hostname = "node"
    node.vm.network "forwarded_port", guest: 22, host: 2251, id: "ssh", auto_correct: true

    node.vm.provider "utm" do |utm|
      utm.name = "skiff-node"
      utm.cpus = 2
      utm.memory = 2048
      utm.directory_share_mode = "virtFS"
    end

    node.vm.provider :libvirt do |libvirt|
      libvirt.driver = "kvm"
      libvirt.cpus = 2
      libvirt.memory = 2048
    end

    node.vm.provision "shell", inline: "echo 'node' > /etc/vagrant_role"
    node.vm.provision "shell", path: "install.sh"
  end
end
